# All optional — defaults shown. Export these in the cron wrapper scripts or your shell.

# Where Hermes Agent lives (state.db, cron/jobs.json, hermes-agent/)
# HERMES_HOME=~/.hermes

# LLM backend for the agents/ roles: "hermes" (one-shot `hermes chat`, uses Hermes' credentials)
# or "anthropic" (direct SDK; needs ANTHROPIC_API_KEY and `pip install anthropic`)
# AGENT_BACKEND=hermes
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Where your stocks and message preferences live (defaults: data/portfolio.yaml, data/preferences.yaml)
# BURSA_PORTFOLIO=
# BURSA_PREFS=

# News scanning
# BURSA_LOOKBACK_HOURS=72
# BURSA_KLSE_CRAWL_DELAY=20          # seconds between KLSE Screener hits (its robots.txt asks for 20)
# BURSA_DELIVER_AT=prefs             # set by the digest/weekly/headline wrappers: hold stdout until the
#                                    # time in data/preferences.yaml. Unset = never hold (manual runs)
# BURSA_MAX_HOLD_SEC=900

# Memory retention (days)
# BURSA_RAW_RETENTION_DAYS=7
# BURSA_URL_RETENTION_DAYS=14
# BURSA_DELIVERED_RETENTION_DAYS=180
# BURSA_NOTE_RETENTION_DAYS=60

# Set to 0 to run bursa-curate without the LLM story clustering
# CURATOR_LLM=1

# Logging
# PIPELINE_LOG_LEVEL=INFO
# PIPELINE_LOG_DIR=./data/logs
